# Optional. The Pika API origin, server only. Defaults to https://api.dev.pika.art
PIKA_API_BASE_URL=

# Optional webhook receiver signing secret from the Pika dashboard.
PIKA_WEBHOOK_SECRET=
# Set to a persistent private volume. Single-process receipt storage only.
PIKA_WEBHOOK_STATE_DIR=

# Share a random secret of at least 32 bytes across upload relay replicas.
# Leave unset on a single self-hosted process to use .data/upload-relay-secret.
# If setting this variable, do not leave it empty.
# PIKA_UPLOAD_RELAY_SECRET=
# Optional persistent directory for the automatically generated relay secret.
PIKA_UPLOAD_RELAY_STATE_DIR=
